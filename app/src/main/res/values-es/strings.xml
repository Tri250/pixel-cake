    </string>

    <string name="buffer_size_title">Tamaño del búfer</string>
    <string name="buffer_size_summary">Tamaño del búfer de salida en pantalla. Un valor mayor muestra más salida a
        costa de rendimiento. (Predeterminado: 16384)
    </string>

    <string name="startup_command_title">Comando de inicio</string>
