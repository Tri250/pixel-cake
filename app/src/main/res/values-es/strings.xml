    <string name="error_waiting_title">Atascado en \"Esperando\"</string>
    <string name="error_waiting_summary">O introdujiste mal los datos de emparejamiento o tu dispositivo no se
        detecta. Primero asegúrate de que la depuración por Wi-Fi esté activada. Si no funciona, prueba la opción
        \"Desvincular\" para volver a emparejar.
    </string>

    <string name="error_no_wireless_debugging_title">Sin interruptor de \"Depuración por Wi-Fi\"</string>
    <string name="error_no_wireless_debugging_summary">Tu dispositivo no admite de forma nativa la depuración por
        Wi-Fi, necesaria para LADB. También puedes activarla con un PC hasta el próximo reinicio. Conecta el
        dispositivo a un PC y ejecuta: adb tcpip 5555
    </string>

