<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_baseline_adb_24"
        android:shortcutDisabledMessage="@string/shortcut_terminal"
        android:shortcutId="terminal"
        android:shortcutLongLabel="@string/shortcut_terminal"
        android:shortcutShortLabel="@string/shortcut_terminal">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.draco.ladb.views.MainActivity"
            android:targetPackage="${applicationId}" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_baseline_bookmarks_24"
        android:shortcutDisabledMessage="@string/shortcut_bookmarks"
        android:shortcutId="bookmarks"
        android:shortcutLongLabel="@string/shortcut_bookmarks"
        android:shortcutShortLabel="@string/shortcut_bookmarks">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.draco.ladb.views.BookmarksActivity"
            android:targetPackage="${applicationId}" />
    </shortcut>
</shortcuts>
