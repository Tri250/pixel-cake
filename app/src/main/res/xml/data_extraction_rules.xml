<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) cloud backup and device-transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Settings, bookmarks and history are worth restoring. -->
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
        <!-- Terminal output is transient and can be megabytes in size. -->
        <exclude domain="file" path="datastore/settings.pb.tmp" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
